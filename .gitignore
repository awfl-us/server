.env
.emulator_data

# Local GCP service account key (DO NOT COMMIT)
serviceAccountKey.json

# Terraform artifacts
infra/.terraform/
infra/native-execution/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.backup

# Local Terraform overrides (keep out of version control)
infra/*.local.auto.tfvars
cloud/sse-consumer/node_modules
package-lock.json
cloud/gcs-harness/node_modules
node_modules

# Independent Terraform root in infra/gke-guardrails
infra/gke-guardrails/.terraform/
infra/gke-guardrails/*.tfstate
infra/gke-guardrails/*.tfstate.backup
infra/gke-guardrails/*.tfplan

# Isolated persistent workspace storage Terraform state and providers.
infra/workspace-storage/.terraform/
infra/workspace-storage/*.tfstate
infra/workspace-storage/*.tfstate.backup
infra/workspace-storage/*.tfplan
